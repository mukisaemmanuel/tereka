{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://tereka-production.up.railway.app/health"
    },
    {
      "source": "/api",
      "destination": "https://tereka-production.up.railway.app/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tereka-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
